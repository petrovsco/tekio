// Roadmap 023 item 2 — dead-code detection. `npm run knip`.
//
// Knip only reports; it never deletes. Its findings are triaged by hand into
// candidate A1 of docs/roadmap/048-simplification-candidates.md, which is the
// brief that does the deleting.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // `src/main.tsx` is found on its own. `middleware.ts` is not: Vercel loads it
  // by file-name convention, so without this line knip calls the auth gate dead
  // code and `@vercel/edge` an unused dependency.
  "entry": ["middleware.ts"],

  // The two edge functions under `supabase/functions/` are a separate Deno
  // project — `jsr:` imports, a different runtime — so they are outside the
  // project rather than ignored inside it.
  "project": ["src/**/*.{ts,tsx}"],

  "ignoreDependencies": [
    // Reached from `@import "tailwindcss"` in src/index.css. Knip does not
    // follow imports inside compiled extensions, so it cannot see that.
    "tailwindcss",

    // Genuinely unimported today — kept on purpose. jsdom, the vitest setup
    // file and `@testing-library/jest-dom` are already wired up, so these two
    // are the rest of the component-testing kit; the first component test
    // needs them and deleting them only means reinstalling them later.
    // Triaged as "keep" for roadmap 023 item 2.
    "@testing-library/react",
    "@testing-library/user-event"
  ]
}
