{
  "name": "tekio",
  "private": true,
  "license": "Apache-2.0",
  "version": "2.2.62",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-api.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:docs": "node scripts/check-docs-links.mjs CLAUDE.md README.md supabase/README.md scripts/garmin-sync/README.md",
    "lint": "eslint .",
    "knip": "knip",
    "perf": "node scripts/perf-budget.mjs",
    "perf:update": "node scripts/perf-budget.mjs --update",
    "perf:startup": "node scripts/perf-startup.mjs",
    "api:client": "node scripts/build-client.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/auth-js": "^2.118.0",
    "@tekio/api": "*",
    "@tekio/client": "*",
    "@tekio/core": "*",
    "@tekio/db": "*",
    "@vercel/edge": "^1.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@supabase/postgrest-js": "^2.105.4",
    "@tailwindcss/vite": "^4.1.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "^0.25.12",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "knip": "^6.34.0",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "^1.55.0",
    "tailwindcss": "^4.1.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
